# Contact form — set in Vercel → Project → Settings → Environment Variables,
# and copy to .env.local for local dev. The NEXT_PUBLIC_ prefix is required:
# the form submits client-side (Web3Forms free tier only accepts browser
# submissions), so the key is inlined into the browser bundle. A Web3Forms
# access key is public by design (it can only trigger mail to your inbox).
#
# Sign up at https://web3forms.com with hello@lukaskaffer.com; it emails the key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Search Console — paste only the content value from the HTML tag, e.g.
# <meta name="google-site-verification" content="THIS_PART" />.
# Set it in Vercel before the production build, then deploy once.
GOOGLE_SITE_VERIFICATION=
